# Server mode: "public" (default) or "admin"
SITE_MODE=public
PORT=3000

# Shared PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zutechsam

# Public origin used for QR codes, Atom feeds, and links (optional; inferred from request if unset)
PUBLIC_BASE_URL=

# Required in public mode if media is served from the admin service
MEDIA_BASE_URL=

# Admin service credentials & upload volume settings (used when SITE_MODE=admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
UPLOAD_DIR=/data/uploads
APK_MAX_MB=1024
